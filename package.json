{
  "name": "ecoroute-backend",
  "version": "1.0.0",
  "description": "Carbon-aware route planner backend — Supabase + Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "_moduleAliases": {
    "@config": "app/config/init.js",
    "@database": "app/database/init.js",
    "@routes": "app/routes/init.js",
    "@controllers": "app/controllers",
    "@middleware": "app/middleware/init.js",
    "@helpers": "app/helpers",
    "@utils": "app/utils",
    "@services": "app/services/init.js",
    "@dto": "app/dto/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
